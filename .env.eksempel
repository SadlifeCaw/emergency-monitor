# Kopier til .env paa driftsmaskinen. .env ligger ikke i repoet.
#
# I udvikling behoever du ingenting: serveren genererer selv et flygtigt
# admin-token og skriver det i opstartsloggen.

# drift | udvikling. I drift naegter serveren at starte uden et rigtigt token.
NATVAGT_MILJOE=udvikling

# Lav et med: npm run token
# NATVAGT_ADMIN_TOKEN=

NATVAGT_VAERT=0.0.0.0
NATVAGT_PORT=8477

NATVAGT_SCENARIE=scenarios/nat.json
NATVAGT_TILSTAND=state/runtime.json

# 1 = realtid. Til generalproeven:
#   NATVAGT_SCENARIE=scenarios/generalprove.json
#   NATVAGT_HASTIGHED=60
#   NATVAGT_VIRTUEL_START=2026-07-15T23:30:00+02:00
NATVAGT_HASTIGHED=1

# Antal loglinjer skaermen holder i hukommelsen. Fast loft mod hukommelseslaek.
NATVAGT_LOGLOFT=200

# Fastlaaser traekket af haendelsestidspunkter.
#
# Normalt trakkes en ny nat, hver gang natvagten startes forfra - saa ligger
# anomalier og dekrypteringer ikke paa de samme klokkeslaet to gange, og heller
# ikke instruktoererne kender dem praecis. Alarmen flytter sig aldrig.
#
# Saet det her, naar en nat skal kunne gentages noejagtigt - fx naar noget skal
# fejlsoeges, eller naar generalproeven skal koeres om paa samme forloeb.
# NATVAGT_TIDSSEED=20260715
